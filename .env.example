PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=sistem_tugas

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# Access token lifetime: seconds or a value such as 15m, 1h, 1d (1 minute to 1 day).
JWT_EXPIRES_IN=1h

# false when clients connect directly; 1 (hop count) behind one reverse proxy.
TRUST_PROXY=false
